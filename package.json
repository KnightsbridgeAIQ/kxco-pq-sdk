{
  "name": "kxco-pq-sdk",
  "version": "2.0.5",
  "description": "Post-quantum institution identity: issue ML-DSA-65 (NIST FIPS 204) credentials to your users and verify the whole chain offline. HSM-backed signing with every signature written to a tamper-evident audit log, and anchoring on Armature L1 where the chain verifies the signature in consensus.",
  "keywords": [
    "post-quantum",
    "pqc",
    "ml-dsa",
    "nist",
    "fips-204",
    "identity",
    "kxco",
    "kyc",
    "verifiable-credential",
    "digital-signature",
    "hierarchical-identity",
    "vLEI",
    "document-signing",
    "compliance",
    "audit-log",
    "hsm",
    "verification-modes",
    "revocation",
    "pqc-migration",
    "crypto-agility",
    "non-repudiation",
    "tamper-evident",
    "pkcs11",
    "credential-issuance",
    "offline-verification"
  ],
  "license": "Apache-2.0",
  "author": "Shayne Heffernan and John Heffernan",
  "contributors": [
    {
      "name": "Shayne Heffernan"
    },
    {
      "name": "John Heffernan"
    }
  ],
  "homepage": "https://kxco.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "ASSESSMENT.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "kxco-post-quantum": "^1.7.8",
    "kxco-pq-hsm": "^1.4.6",
    "kxco-pq-audit": "^1.4.5",
    "kxco-pq-attest": "^2.0.7",
    "kxco-pq-network": "^1.0.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 test/identity.test.js test/property.test.js test/ml-dsa-87.test.js",
    "evidence": "node scripts/build-evidence.mjs"
  },
  "funding": "https://kxco.ai",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
