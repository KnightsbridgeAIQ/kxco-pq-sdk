{
  "name": "kxco-pq-sdk",
  "version": "2.0.0",
  "description": "Institution identity for the KXCO stack: hierarchical ML-DSA-65 credentials, HSM-backed signing, and anchoring on Armature L1 where the chain verifies the signature in consensus rather than a server doing it.",
  "keywords": [
    "post-quantum",
    "pqc",
    "ml-dsa",
    "nist",
    "fips-204",
    "identity",
    "kxco",
    "kyc",
    "verifiable-credential",
    "digital-signature",
    "hierarchical-identity",
    "vLEI",
    "document-signing",
    "compliance",
    "audit-log",
    "hsm",
    "verification-modes",
    "revocation"
  ],
  "license": "Apache-2.0",
  "author": "Shayne Heffernan and John Heffernan",
  "contributors": [
    {
      "name": "Shayne Heffernan"
    },
    {
      "name": "John Heffernan"
    }
  ],
  "homepage": "https://kxco.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "kxco-post-quantum": "^1.6.0",
    "kxco-pq-hsm": "^1.0.9",
    "kxco-pq-audit": "^1.1.5",
    "kxco-pq-attest": "^2.0.0",
    "kxco-pq-network": "^1.0.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 test/identity.test.js"
  },
  "funding": "https://kxco.ai",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
